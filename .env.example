# ==== OpenAI (STT + LLM + TTS fallback) — required, paid usage-based, has trial credit ====
OPENAI_API_KEY=

# ==== ElevenLabs (optional but recommended for a more natural Egyptian-Arabic voice) ====
# Leave empty to fall back to OpenAI TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ==== Twilio (phone number + call handling) — free trial number, usage beyond trial is paid ====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==== Resend (order notification emails) — free tier available ====
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=orders@yourdomain.com

# ==== App ====
# Public base URL Twilio can reach (e.g. your Vercel deployment URL).
APP_BASE_URL=http://localhost:3000
# Shared secret brand owners see once, used to protect the dashboard API in this MVP.
DASHBOARD_ADMIN_TOKEN=change-me
